
@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members

package "Domínio — models.py" {
  class Categoria {
    - _id: int | None
    - _nome: str
    - _tipo_permitido: str
    + id: int | None
    + nome: str
    + tipo_permitido: str
    + tipo: str
    + para_dict(): dict
  }

  abstract class Transacao {
    - _id: int | None
    - _descricao: str
    - _valor_centavos: int
    - _data: date
    - _categoria: Categoria
    + id: int | None
    + descricao: str
    + valor_centavos: int
    + data: str
    + data_br: str
    + categoria: Categoria
    + valor_reais: float
    {abstract} + tipo: str
    {abstract} + impacto_no_saldo(): int
    {static} + converter_para_centavos(valor): int
    + para_dict(): dict
  }

  class Receita {
    + tipo: str
    + impacto_no_saldo(): int
  }

  class Despesa {
    + tipo: str
    + impacto_no_saldo(): int
  }

  class ErroValidacaoFinanceira {
    + mensagem: str
    + campos: dict
  }

  class RegistroNaoEncontradoErro {
    + mensagem: str
  }
}

package "Negócio — servico.py" {
  class GerenciadorFinanceiro {
    - _repositorio: RepositorioTransacoes
    + listar_categorias(tipo): list
    - _construir_transacao_a_partir_de_dados(dados, id): Transacao
    + cadastrar_lancamento(dados): Transacao
    + editar_lancamento(id, dados): Transacao
    + excluir_lancamento(id): None
    {static} - _obter_intervalo_mes(mes): tuple
    {static} - _validar_intervalo_datas(inicio, fim): None
    + consultar_lancamentos(...): list
    + calcular_resumo(...): dict
    + exportar_csv(...): str
  }
}

package "Persistência — persistencia_supabase.py" {
  class RepositorioTransacoes {
    - _client: Client
    + listar_categorias(tipo): list
    + buscar_categoria_por_id(id): Categoria
    - _instanciar_transacao(linha): Transacao
    + salvar(transacao): Transacao
    + atualizar(transacao): Transacao
    + excluir(id): None
    + buscar_por_id(id): Transacao
    + listar_todos(): list
  }
}

class "Flask app.py" as FlaskAPI <<API>>
class "Supabase" as DB <<database>>

' Herança
Transacao <|-- Receita
Transacao <|-- Despesa

' Associação: uma categoria para várias transações
Transacao "0..*" --> "1" Categoria : classificada em

' Relacionamento entre serviço e repositório
GerenciadorFinanceiro "1" --> "1" RepositorioTransacoes : utiliza

' Dependências
GerenciadorFinanceiro ..> Transacao : cria e consulta
RepositorioTransacoes ..> Transacao : materializa e persiste
RepositorioTransacoes ..> Categoria : consulta

' Persistência
RepositorioTransacoes --> DB : banco de dados

' API Flask
FlaskAPI --> GerenciadorFinanceiro : chama

' Tratamento de erros
GerenciadorFinanceiro ..> ErroValidacaoFinanceira : pode lançar
RepositorioTransacoes ..> RegistroNaoEncontradoErro : pode lançar

note bottom of Transacao
  POO: abstração, encapsulamento,
  herança e polimorfismo por
  impacto_no_saldo().
end note

@enduml
